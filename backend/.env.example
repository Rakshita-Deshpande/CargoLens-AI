# Copy this file to .env and fill in values. NEVER commit .env.

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random key is generated at startup (logins reset on every restart).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# Default is a local SQLite file in backend/. For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/cargolens
# DATABASE_URL=

# --- Uploads ---
# UPLOAD_DIR=
MAX_UPLOAD_MB=10

# --- Demo data ---
# Creates demo users (executive/manager) and synthetic shipments. Set to false in production.
SEED_DEMO_DATA=true

# --- AI provider (Google Gemini) ---
# Without BOTH of the next two settings, the app uses the clearly labelled DEMO/FALLBACK extractor.
GOOGLE_API_KEY=
# Set to true ONLY after you have verified the provider's data-processing / no-training terms
# for confidential client documents (and India-region / DPDP Act 2023 requirements).
AI_DATA_PROCESSING_VERIFIED=false
GEMINI_MODEL=gemini-2.5-flash

# --- Validation thresholds (provisional demo defaults - need client approval) ---
LOW_CONFIDENCE_THRESHOLD=0.80
WEIGHT_TOLERANCE_PCT=0.5
AMOUNT_TOLERANCE=0.01

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
